{
  "name": "jev-screen-mcp",
  "version": "0.1.0",
  "description": "Single-purpose MCP tool powered by TypeSafe Jev (System One decision model): a content-moderation & classification gate (allow / review / block). The agent gets a typed decision, not prose.",
  "license": "MIT",
  "type": "module",
  "bin": {
    "jev-screen-mcp": "dist/index.js"
  },
  "main": "dist/index.js",
  "files": [
    "dist",
    "README.md",
    "LICENSE",
    "skills"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "start": "node dist/index.js",
    "doctor": "node dist/index.js doctor",
    "test": "node --test test/smoke.test.mjs"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "jev",
    "typesafe",
    "system-one",
    "decision-model",
    "moderation",
    "content-safety"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^22.5.0",
    "typescript": "^5.5.4"
  }
}
