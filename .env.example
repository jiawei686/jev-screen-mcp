# TypeSafe Jev API key (optional). Without it the server runs in deterministic mock mode.
TYPESAFE_API_KEY=ts_xxx

# Force deterministic mock even if a key is present:
# JEV_MCP_MOCK=1

# Optional overrides:
# JEV_MODEL=jev-latest
# JEV_BASE_URL=https://api.typesafe.ai/v1/systemone
# JEV_MCP_TIMEOUT_MS=30000
